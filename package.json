{
  "name": "ani-tracker",
  "version": "0.1.0",
  "description": "A local anime tracking, release matching, and download manager.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dev": "pnpm run prepare:remote-renderer && electron-vite dev",
    "dev:desktop": "electron-vite dev",
    "build": "electron-vite build && npm run prepare:qbittorrent && npm run prepare:ffmpeg",
    "preview": "electron-vite preview",
    "prepare:remote-renderer": "electron-vite build --outDir .remote-pwa",
    "prepare:qbittorrent": "node scripts/prepare-qbittorrent-resources.mjs",
    "verify:qbittorrent": "node scripts/prepare-qbittorrent-resources.mjs --required",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg-resources.mjs",
    "verify:ffmpeg": "node scripts/prepare-ffmpeg-resources.mjs --verify-all",
    "download:ffmpeg": "node scripts/download-ffmpeg-resources.mjs --all",
    "typecheck": "tsc -p tsconfig.typecheck.node.json --pretty false && tsc -p tsconfig.typecheck.web.json --pretty false",
    "test:parsers": "node scripts/run-node-tests.mjs",
    "test:theme": "node scripts/verify-theme-contrast.mjs"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slider": "^1.4.4",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toggle": "^1.1.14",
    "@radix-ui/react-toggle-group": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tanstack/react-query": "^5.59.16",
    "@tanstack/react-table": "^8.20.5",
    "artplayer": "5.4.0",
    "better-sqlite3": "11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fast-xml-parser": "^4.5.0",
    "hls.js": "^1.6.16",
    "lucide-react": "^0.468.0",
    "node-forge": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.0.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22.7.5",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^32.1.2",
    "electron-vite": "^2.3.0",
    "https-proxy-agent": "^7.0.6",
    "postcss": "^8.4.47",
    "shadcn": "^4.13.0",
    "tailwindcss": "^3.4.13",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
