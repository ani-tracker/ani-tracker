{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ani Tracker",
  "version": "0.1.0",
  "identifier": "com.ani.tracker",
  "build": {
    "beforeDevCommand": "pnpm run dev:tauri:renderer",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm run build:tauri:renderer",
    "frontendDist": "../out/tauri"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Ani Tracker",
        "width": 1240,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "decorations": false,
        "backgroundColor": "#f8fafc"
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": {
      "minSdkVersion": 26
    },
    "iOS": {
      "minimumSystemVersion": "16.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
